#. Plugin Name of the plugin
#: gustinai-multilingual.php
msgid "GustinAI Multilingual"
msgstr "GustinAI Multilingual"

#. Plugin URI of the plugin
#. Author URI of the plugin
#: gustinai-multilingual.php
msgid "https://gustinai.com"
msgstr "https://gustinai.com"

#. Description of the plugin
#: gustinai-multilingual.php
msgid "Turn any WordPress site into a fast, SEO & GEO-ready multilingual site. AI translation with Claude or ChatGPT, translated slugs, categories and menus, hreflang, llms.txt. Works with Gutenberg, Elementor and Divi."
msgstr "Transformez n’importe quel site WordPress en site multilingue rapide, optimisé SEO et GEO. Traduction par IA avec Claude ou ChatGPT, slugs, catégories et menus traduits, hreflang, llms.txt. Compatible Gutenberg, Elementor et Divi."

#. Author of the plugin
#: gustinai-multilingual.php
msgid "Thierry Gustin"
msgstr "Thierry Gustin"

