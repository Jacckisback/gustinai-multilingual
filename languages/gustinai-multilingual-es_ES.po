#. Plugin Name of the plugin
#: gustinai-multilingual.php
msgid "GustinAI Multilingual"
msgstr "GustinAI Multilingual"

#. Plugin URI of the plugin
#. Author URI of the plugin
#: gustinai-multilingual.php
msgid "https://gustinai.com"
msgstr "https://gustinai.com"

#. Description of the plugin
#: gustinai-multilingual.php
msgid "Turn any WordPress site into a fast, SEO & GEO-ready multilingual site. AI translation with Claude or ChatGPT, translated slugs, categories and menus, hreflang, llms.txt. Works with Gutenberg, Elementor and Divi."
msgstr "Convierte cualquier sitio WordPress en un sitio multilingüe rápido y optimizado para SEO y GEO. Traducción con IA mediante Claude o ChatGPT, slugs, categorías y menús traducidos, hreflang, llms.txt. Compatible con Gutenberg, Elementor y Divi."

#. Author of the plugin
